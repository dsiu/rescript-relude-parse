{
  "name": "rescript-relude-parse",
  "version": "0.8.0",
  "description": "Monadic parsing with Relude",
  "tpye": "module",
  "scripts": {
    "clean": "rescript clean",
    "build": "rescript build",
    "watch": "rescript watch",
    "test": "jest",
    "coverage": "jest --coverage --coverage-reporters=lcov --coverage-reporters=text --coverage-directory ./docs/coverage",
    "cleanbuild": "yarn run clean && yarn run build",
    "cleantest": "yarn run cleanbuild && yarn run test",
    "cleancoverage": "yarn run cleanbuild && yarn run coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reazen/relude-parse.git"
  },
  "author": "Reazen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/reazen/relude-parse/issues"
  },
  "homepage": "https://github.com/reazen/relude-parse#readme",
  "peerDependencies": {
    "rescript": "^12.3.0",
    "rescript-bastet": "*",
    "rescript-relude": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@glennsl/rescript-jest": "github:dsiu/rescript-jest#rescript-v12-wip",
    "babel-jest": "^27.3.1",
    "jest": "^27.3.1",
    "rescript": "^12.3.0",
    "rescript-bastet": "github:dsiu/rescript-bastet#rescript-v12",
    "rescript-relude": "github:dsiu/rescript-relude#rescript-v12"
  },
  "jest": {
    "verbose": false,
    "testMatch": [
      "**/__tests__/**/*_test.res.mjs"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/testUtils/"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/testUtils/"
    ],
    "transform": {
      "^.+\\.m?jsx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ]
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "<rootDir>/node_modules/(?!(rescript|@rescript/runtime|@glennsl/rescript-jest|rescript-relude|rescript-bastet)/)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "mjs"
    ]
  },
  "packageManager": "yarn@4.17.0"
}
